  "MICME_AVFOUNDATION_DROP_LATE_FRAMES": "0",
  "MICME_PROCESS_AUDIO": "1",
  "MICME_AUDIO_FILTER": "highpass=f=80,lowpass=f=7600",
  "MICME_VALIDATE_AUDIO": "1",
  "MICME_KEEP_AUDIO": "0",
  "MICME_METER_GAIN": "1",
  "MICME_LIVE_BIN": "",
  "MICME_VAD_MODEL": "",
  "MICME_STREAM_FINALIZE_WITH_CLIP": "0",
  "MICME_STREAM_DIAGNOSTICS": "0",
  "MICME_ARTIFACT": "",
  "MICME_COMPUTE": "auto",
  "MICME_MODEL_IDLE": "immediate",
  "MICME_CHUNKING": "1",
  "MICME_DETECTOR": "model",
  "MICME_PREFERRED_LANGUAGES": "[]",
  "MICME_WORDS": "[]",
  "MICME_FILLERS": "[]",
  "MICME_LOCAL_LID": "0",
  "MICME_REMOVE_FILLERS": "0",
  "MICME_SCRIPT": "as-spoken",
  "MICME_HISTORY": "0",
  "MICME_RETENTION": "never",
  "MICME_POLISH_PROVIDER": "",
  "MICME_POLISH_ENDPOINT": "",
  "MICME_POLISH_MODEL": "",
  "MICME_POLISH_PROMPT": "",
  "MICME_POLISH_KEY_ENV": "",
  "MICME_OUTPUT_HOOK": ""
