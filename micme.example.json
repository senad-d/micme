{
  "$schema": "https://raw.githubusercontent.com/senad-d/micme/main/micme.schema.json",
  "MICME_SHORTCUT": "alt+m",
  "MICME_TRANSCRIPTION_MODE": "clip",
  "MICME_TRANSCRIBE_BACKEND": "auto",
  "MICME_AUTO_SUBMIT": "0",
  "MICME_LANGUAGE": "en",
  "MICME_TRANSLATE_TO_ENGLISH": "off",
  "MICME_TRANSCRIBE_TIMEOUT_MS": "120000",
  "MICME_AUTO_DOWNLOAD_MODEL": "1",
  "MICME_MODEL_DIR": "${HOME}/.cache/whisper.cpp",
  "MICME_AUDIO_DEVICE": "0",
  "MICME_RECORD_SAMPLE_RATE": "auto",
  "MICME_TRANSCRIBE_SAMPLE_RATE": "16000",
  "MICME_RECORD_SYNC": "1",
